# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# In production, source these from AWS SSM Parameter Store / Secrets Manager.

TARGET_URL=https://example.com/app
LOGIN_URL=https://example.com/login
TARGET_USERNAME=
TARGET_PASSWORD=

# Selectors for the login form (adjust to the real site).
SEL_USERNAME=input[name="username"]
SEL_PASSWORD=input[name="password"]
SEL_SUBMIT=button[type="submit"]
# A selector only present once authenticated (lets the service detect a live session).
SEL_LOGGED_IN=

# Service bind (leave as-is locally).
HOST=127.0.0.1
PORT=3001
