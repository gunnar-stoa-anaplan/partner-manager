# Production env template for the Docker deploy (docker-compose.prod.yml).
# Copy to .env on the server and fill in. Generate APP_KEY with:
#   docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show

APP_NAME="Partner Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database — points at the "db" service in the compose network.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=partner_manager
DB_USERNAME=sail
DB_PASSWORD=

# Warehouse connection (same server, wh schema).
WAREHOUSE_DB_DATABASE=partner_manager
WAREHOUSE_DB_SEARCH_PATH=wh

# Everything on the database driver (no Redis in this deploy).
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Playwright automation service (optional; only if you run automation/).
PLAYWRIGHT_URL=http://127.0.0.1:3001
